# Required Vercel Function secret
WEATHER_API_KEY=replace_with_weatherapi_key

# Exact comma-separated browser origins; local Flutter dev uses this value.
CORS_ORIGINS=http://localhost:8080

# Optional bounded function-instance settings.
WEATHER_TIMEOUT_MS=10000
WEATHER_TOTAL_TIMEOUT_MS=15000
WEATHER_RETRY_DELAY_MS=300
CACHE_TTL_MS=300000
MAX_CACHE_ENTRIES=256
MAX_CONCURRENT_UPSTREAM=8
UPSTREAM_REQUESTS_PER_MINUTE=60
IP_REQUESTS_PER_MINUTE=30
MAX_IP_BUCKETS=5000
